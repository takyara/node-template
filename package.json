{
	"name": "node-template",
	"version": "0.0.0",
	"private": true,
	"description": "Node.js 26 + TypeScript template following Conventional Commits",
	"license": "MIT",
	"type": "module",
	"engines": {
		"node": ">=26.0.0"
	},
	"scripts": {
		"dev": "node --watch --env-file-if-exists=.env src/index.ts",
		"clean": "node -e \"for (const d of ['dist','coverage']) fs.rmSync(d,{recursive:true,force:true})\"",
		"build": "npm run clean && tsc -p tsconfig.build.json",
		"start": "node --enable-source-maps --env-file-if-exists=.env dist/index.js",
		"typecheck": "tsc",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"lint": "eslint . --max-warnings=0",
		"lint:fix": "eslint . --fix",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"prepare": "husky",
		"commit": "commit"
	},
	"devDependencies": {
		"@commitlint/cli": "21.2.4",
		"@commitlint/config-conventional": "21.2.4",
		"@commitlint/prompt-cli": "21.2.4",
		"@eslint/js": "10.0.1",
		"@types/node": "26.6.6",
		"@vitest/coverage-v8": "5.1.0",
		"eslint": "10.14.0",
		"eslint-config-prettier": "10.1.8",
		"globals": "17.14.0",
		"husky": "9.1.7",
		"lint-staged": "17.6.0",
		"prettier": "3.9.10",
		"typescript": "6.0.3",
		"typescript-eslint": "8.72.1",
		"vitest": "5.1.0"
	},
	"lint-staged": {
		"*.{ts,js}": [
			"eslint --fix --max-warnings=0",
			"prettier --write"
		],
		"*.{json,md,yml,yaml}": "prettier --write"
	}
}
