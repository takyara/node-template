{
	"$schema": "https://json.schemastore.org/package.json",
	"name": "node-template",
	"version": "0.0.0",
	"private": true,
	"description": "Node.js 26 + TypeScript template following Conventional Commits",
	"keywords": [],
	"homepage": "",
	"bugs": {
		"url": "",
		"email": ""
	},
	"repository": {
		"type": "git",
		"url": ""
	},
	"funding": {
		"type": "",
		"url": ""
	},
	"license": "MIT",
	"author": {
		"name": "Takyara Studio",
		"email": "",
		"url": ""
	},
	"contributors": [],
	"maintainers": [],
	"type": "module",
	"exports": {
		".": "./dist/index.js",
		"./package.json": "./package.json"
	},
	"main": "./dist/index.js",
	"types": "",
	"imports": {},
	"bin": {},
	"man": [],
	"directories": {},
	"files": [
		"dist"
	],
	"workspaces": [],
	"scripts": {
		"dev": "node --watch --env-file-if-exists=.env src/index.ts",
		"clean": "node -e \"for (const d of ['dist','coverage']) fs.rmSync(d,{recursive:true,force:true})\"",
		"build": "npm run clean && tsc -p tsconfig.build.json",
		"start": "node --enable-source-maps --env-file-if-exists=.env dist/index.js",
		"typecheck": "tsc",
		"lint": "eslint . --max-warnings=0",
		"lint:fix": "eslint . --fix",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"knip": "knip",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"commit": "commit",
		"prepare": "husky"
	},
	"config": {},
	"lint-staged": {
		"*.{ts,js}": [
			"eslint --fix --max-warnings=0",
			"prettier --write"
		],
		"*.{json,md,yml,yaml}": "prettier --write"
	},
	"dependencies": {},
	"devDependencies": {
		"@commitlint/cli": "21.2.4",
		"@commitlint/config-conventional": "21.2.4",
		"@commitlint/prompt-cli": "21.2.4",
		"@eslint/js": "10.0.1",
		"@types/node": "26.6.6",
		"@vitest/coverage-v8": "5.1.0",
		"eslint": "10.14.0",
		"eslint-config-prettier": "10.1.8",
		"globals": "17.14.0",
		"husky": "9.1.7",
		"knip": "6.44.2",
		"lint-staged": "17.6.0",
		"prettier": "3.9.10",
		"typescript": "7.0.2",
		"typescript-eslint": "8.72.1",
		"vitest": "5.1.0"
	},
	"peerDependencies": {},
	"peerDependenciesMeta": {},
	"optionalDependencies": {},
	"bundleDependencies": [],
	"overrides": {},
	"engines": {
		"node": ">=26.0.0",
		"npm": ">=11.0.0"
	},
	"os": [],
	"cpu": [],
	"packageManager": "npm@11.16.0",
	"publishConfig": {}
}
